[Unit]
Description=Claude Session Replay MCP Server
After=network.target

[Service]
Type=simple
Environment=PORT=9241
EnvironmentFile=-/home/opa/volta-secrets/claude-session-replay.env
ExecStart=/home/opa/work/tools-workspace/claude-session-replay/run_mcp.sh
WorkingDirectory=/home/opa/work/tools-workspace/claude-session-replay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
